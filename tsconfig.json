{
  "compilerOptions": {
    "types": ["mocha", "chai"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2015"],
    "module": "commonjs",
    "target": "es6",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowJs": true,
    "outDir": "dist",
    "paths": {
      "@coral-xyz/anchor": ["./node_modules/@coral-xyz/anchor"]
    }
  },
  "include": ["tests/**/*", "target/types/**/*"]
}